{
  "name": "Laya - Bitbucket Server Executor",
  "nodes": [
    {
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        250,
        300
      ],
      "parameters": {
        "path": "bitbucket-server-executor",
        "httpMethod": "POST",
        "responseMode": "responseNode"
      }
    },
    {
      "name": "Validate",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        450,
        300
      ],
      "notes": "payload.base_url is injected by the engine from the connection's server credential (payload_credential_fields) - it is never LLM-supplied. workspace carries the Server project key.",
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.body.payload.base_url || '' }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEquals"
              }
            },
            {
              "leftValue": "={{ $json.body.payload.workspace || '' }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEquals"
              }
            },
            {
              "leftValue": "={{ $json.body.payload.repo || '' }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEquals"
              }
            },
            {
              "leftValue": "={{ String($json.body.payload.pr_id || '') }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEquals"
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "name": "Route Action",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [
        650,
        200
      ],
      "parameters": {
        "rules": {
          "values": [
            {
              "outputKey": "comment_pr",
              "conditions": {
                "options": {
                  "caseSensitive": false,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.body.action_type }}",
                    "rightValue": "comment_pr",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              }
            },
            {
              "outputKey": "approve_pr",
              "conditions": {
                "options": {
                  "caseSensitive": false,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.body.action_type }}",
                    "rightValue": "approve_pr",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              }
            },
            {
              "outputKey": "decline_pr",
              "conditions": {
                "options": {
                  "caseSensitive": false,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.body.action_type }}",
                    "rightValue": "decline_pr",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              }
            },
            {
              "outputKey": "merge_pr",
              "conditions": {
                "options": {
                  "caseSensitive": false,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.body.action_type }}",
                    "rightValue": "merge_pr",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              }
            }
          ]
        },
        "fallbackOutput": "extra"
      }
    },
    {
      "name": "Comment on PR",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        950,
        -100
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $json.body.payload.base_url + '/rest/api/1.0/projects/' + $json.body.payload.workspace + '/repos/' + $json.body.payload.repo + '/pull-requests/' + $json.body.payload.pr_id + '/comments' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify(Object.assign({ text: $json.body.payload.comment || '' }, $json.body.payload.comment_id ? { parent: { id: Number($json.body.payload.comment_id) } } : {})) }}",
        "options": {
          "allowUnauthorizedCerts": "={{ $('Webhook').first().json.body.payload.allow_insecure_ssl === true }}"
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACED_AT_CLONE",
          "name": "Bitbucket Server"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "name": "Whoami",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        950,
        150
      ],
      "notes": "Bitbucket Server removed the deprecated POST .../approve endpoint; approval is PUT .../participants/{userSlug}. The slug of the authenticated user isn't in any participants payload we hold, so resolve it via the applinks whoami servlet (returns the plain-text username; the user slug is its lowercased form).",
      "parameters": {
        "method": "GET",
        "url": "={{ $json.body.payload.base_url + '/plugins/servlet/applinks/whoami' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "response": {
            "response": {
              "responseFormat": "text"
            }
          },
          "allowUnauthorizedCerts": "={{ $('Webhook').first().json.body.payload.allow_insecure_ssl === true }}"
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACED_AT_CLONE",
          "name": "Bitbucket Server"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "name": "Approve PR",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1150,
        150
      ],
      "parameters": {
        "method": "PUT",
        "url": "={{ $('Webhook').first().json.body.payload.base_url + '/rest/api/1.0/projects/' + $('Webhook').first().json.body.payload.workspace + '/repos/' + $('Webhook').first().json.body.payload.repo + '/pull-requests/' + $('Webhook').first().json.body.payload.pr_id + '/participants/' + encodeURIComponent(String($json.data || '').trim().toLowerCase()) }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ status: 'APPROVED' }) }}",
        "options": {
          "allowUnauthorizedCerts": "={{ $('Webhook').first().json.body.payload.allow_insecure_ssl === true }}"
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACED_AT_CLONE",
          "name": "Bitbucket Server"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "name": "Get PR For Decline",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        950,
        400
      ],
      "notes": "Decline requires the PR's current version (409 on mismatch/omission), so fetch it first.",
      "parameters": {
        "method": "GET",
        "url": "={{ $json.body.payload.base_url + '/rest/api/1.0/projects/' + $json.body.payload.workspace + '/repos/' + $json.body.payload.repo + '/pull-requests/' + $json.body.payload.pr_id }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "allowUnauthorizedCerts": "={{ $('Webhook').first().json.body.payload.allow_insecure_ssl === true }}"
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACED_AT_CLONE",
          "name": "Bitbucket Server"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "name": "Decline PR",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1150,
        400
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Webhook').first().json.body.payload.base_url + '/rest/api/1.0/projects/' + $('Webhook').first().json.body.payload.workspace + '/repos/' + $('Webhook').first().json.body.payload.repo + '/pull-requests/' + $('Webhook').first().json.body.payload.pr_id + '/decline?version=' + $json.version }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "allowUnauthorizedCerts": "={{ $('Webhook').first().json.body.payload.allow_insecure_ssl === true }}"
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACED_AT_CLONE",
          "name": "Bitbucket Server"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "name": "Get PR For Merge",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        950,
        650
      ],
      "notes": "Merge requires the PR's current version (409 on mismatch/omission), so fetch it first.",
      "parameters": {
        "method": "GET",
        "url": "={{ $json.body.payload.base_url + '/rest/api/1.0/projects/' + $json.body.payload.workspace + '/repos/' + $json.body.payload.repo + '/pull-requests/' + $json.body.payload.pr_id }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "allowUnauthorizedCerts": "={{ $('Webhook').first().json.body.payload.allow_insecure_ssl === true }}"
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACED_AT_CLONE",
          "name": "Bitbucket Server"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "name": "Merge PR",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1150,
        650
      ],
      "notes": "merge_strategy is optional: when absent the body is {} and the server applies the repo's configured strategy. Cloud strategy names map to Server strategyIds (merge_commit->no-ff, squash->squash, fast_forward->ff); unknown values pass through so a user-supplied native strategyId also works.",
      "parameters": {
        "method": "POST",
        "url": "={{ $('Webhook').first().json.body.payload.base_url + '/rest/api/1.0/projects/' + $('Webhook').first().json.body.payload.workspace + '/repos/' + $('Webhook').first().json.body.payload.repo + '/pull-requests/' + $('Webhook').first().json.body.payload.pr_id + '/merge?version=' + $json.version }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($('Webhook').first().json.body.payload.merge_strategy ? { strategyId: ({ merge_commit: 'no-ff', squash: 'squash', fast_forward: 'ff' })[$('Webhook').first().json.body.payload.merge_strategy] || $('Webhook').first().json.body.payload.merge_strategy } : {}) }}",
        "options": {
          "allowUnauthorizedCerts": "={{ $('Webhook').first().json.body.payload.allow_insecure_ssl === true }}"
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACED_AT_CLONE",
          "name": "Bitbucket Server"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "name": "Respond Comment Success",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        1400,
        -150
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ success: true, result: { action: 'comment_pr', pr_id: $('Webhook').first().json.body.payload.pr_id, comment_id: $json.id || '' } }) }}"
      }
    },
    {
      "name": "Respond Comment Error",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        1400,
        -50
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ success: false, error: ($json.error ? ($json.error.description || $json.error.message || JSON.stringify($json.error)) : 'Bitbucket Server comment_pr failed — check credentials and workflow execution log') }) }}"
      }
    },
    {
      "name": "Respond Approve Success",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        1400,
        100
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ success: true, result: { action: 'approve_pr', pr_id: $('Webhook').first().json.body.payload.pr_id } }) }}"
      }
    },
    {
      "name": "Respond Approve Error",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        1400,
        200
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ success: false, error: ($json.error ? ($json.error.description || $json.error.message || JSON.stringify($json.error)) : 'Bitbucket Server approve_pr failed — check credentials and workflow execution log') }) }}"
      }
    },
    {
      "name": "Respond Decline Success",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        1400,
        350
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ success: true, result: { action: 'decline_pr', pr_id: $('Webhook').first().json.body.payload.pr_id } }) }}"
      }
    },
    {
      "name": "Respond Decline Error",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        1400,
        450
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ success: false, error: ($json.error ? ($json.error.description || $json.error.message || JSON.stringify($json.error)) : 'Bitbucket Server decline_pr failed — check credentials and workflow execution log') }) }}"
      }
    },
    {
      "name": "Respond Merge Success",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        1400,
        600
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ success: true, result: { action: 'merge_pr', pr_id: $('Webhook').first().json.body.payload.pr_id, merge_strategy: $('Webhook').first().json.body.payload.merge_strategy || 'repo default' } }) }}"
      }
    },
    {
      "name": "Respond Merge Error",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        1400,
        700
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ success: false, error: ($json.error ? ($json.error.description || $json.error.message || JSON.stringify($json.error)) : 'Bitbucket Server merge_pr failed — check credentials and workflow execution log') }) }}"
      }
    },
    {
      "name": "Respond Missing Fields",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        650,
        500
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ success: false, error: 'Missing required fields: payload must include base_url (injected by the engine from the connection — reconnect the Bitbucket Server integration if absent), workspace (project key), repo, and pr_id' }) }}"
      }
    },
    {
      "name": "Respond Unknown Action",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        950,
        850
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ success: false, error: 'Unknown action_type: ' + ($json.body.action_type || 'empty') + '. Supported: comment_pr, approve_pr, decline_pr, merge_pr' }) }}"
      }
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Validate",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validate": {
      "main": [
        [
          {
            "node": "Route Action",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Respond Missing Fields",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Route Action": {
      "main": [
        [
          {
            "node": "Comment on PR",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Whoami",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Get PR For Decline",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Get PR For Merge",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Respond Unknown Action",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Comment on PR": {
      "main": [
        [
          {
            "node": "Respond Comment Success",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Respond Comment Error",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Whoami": {
      "main": [
        [
          {
            "node": "Approve PR",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Respond Approve Error",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Approve PR": {
      "main": [
        [
          {
            "node": "Respond Approve Success",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Respond Approve Error",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get PR For Decline": {
      "main": [
        [
          {
